{
  "name": "lecture-recorder",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "test": "node tools/test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "android:devclient": "expo run:android",
    "ios:devclient": "expo run:ios",
    "build:web": "expo export --platform web",
    "build:devclient:android": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "build:devclient:web": "expo export --platform web --output-dir dist/web"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "expo": "~57.0.29",
    "expo-audio": "^57.0.5",
    "expo-file-system": "^57.0.7",
    "expo-sharing": "^57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.4",
    "react-native-audio-api": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "config": {}
}
